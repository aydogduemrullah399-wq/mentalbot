# Discord Developer Portal'dan aldığın bot token'ı
TOKEN=

# Discord Developer Portal > OAuth2 > Client ID
CLIENT_ID=

# Komutları test ederken hızlı güncellensin diye sunucu ID'si (opsiyonel ama önerilir)
GUILD_ID=

# Ticket kanallarının açılacağı kategori ID'si
TICKET_CATEGORY_ID=

# Ticket'ları görebilecek destek rolü ID'si
SUPPORT_ROLE_ID=

# (Opsiyonel) Ban/kick/clear/ticket işlemlerinin loglanacağı kanal
LOG_CHANNEL_ID=
